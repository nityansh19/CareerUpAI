# Use a hosted MongoDB connection string in production.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/careerforge
# Changed: provide the actual Atlas URI privately in the backend host's environment settings.

FRONTEND_URL=https://careerupai.netlify.app
# Changed: configure the browser origin allowed to call the backend; use http://localhost:5173 for local development.

NODE_ENV=production
# Changed: require an explicit database URI in production; use development when working with local MongoDB.

# Hosting platforms usually inject PORT automatically.
PORT=5000
