MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/careerupai
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://career-up-ai-delta.vercel.app
# Set to the number of trusted reverse proxies used by your host.
TRUST_PROXY=1

# Transactional email used for account verification.
# Create a Resend API key and use a sender on a domain you have verified.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=CareerUpAI <verify@yourdomain.com>
